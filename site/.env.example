# 复制成 .env.local（本地）或填进 Vercel 的环境变量（线上）。.env.local 不进版本库。
# 下面全是占位值，不要把真实密钥写进这个文件。

# 托管 PostgreSQL 连接。依次执行 db/migrations/ 下的 0001、0002 两个 SQL 文件。
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Auth.js 会话密钥。可使用 `npx auth secret` 生成。
AUTH_SECRET=replace_with_a_long_random_auth_secret

# 邮箱登录：Resend 的 API Key 与已验证域名下的发件地址。
# 本地开发不填 AUTH_RESEND_KEY 时，登录链接会直接打印在 dev 服务器终端里。
AUTH_RESEND_KEY=re_replace_me
AUTH_EMAIL_FROM=Ethan 音乐实验室 <login@example.com>

# 管理员邮箱，逗号分隔。可以删除任何评论、查看全站浏览统计。
ADMIN_EMAILS=you@example.com

# 文章后台（/admin）：保存文章时提交到 GitHub 仓库，Vercel 随后自动重新部署。
# 令牌用 GitHub 的 Fine-grained token，仓库只选这一个，权限给 Contents: Read and write。
GITHUB_TOKEN=github_pat_replace_me
# 可选，默认就是下面两个值
GITHUB_REPO=EthanBAI-dev/Audio-ML-note
GITHUB_BRANCH=main

# 可选：微信开放平台「网站应用」的 AppID 与 AppSecret，不填就不显示微信登录。
# 回调地址：https://你的域名/api/auth/callback/wechat
AUTH_WECHAT_ID=replace_with_wechat_app_id
AUTH_WECHAT_SECRET=replace_with_wechat_app_secret
