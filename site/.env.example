# 官网地址。正式环境填写你的自定义域名，不要带末尾斜杠。
NEXT_PUBLIC_SITE_URL=https://example.com

# 免费图文版文章中展示并用于渠道追踪的正式官网。
FREE_EDITION_SITE_URL=https://example.com

# 单次购买价格，单位为人民币元。
COURSE_PRICE_CNY=199

# Stripe 测试或正式环境密钥。服务端密钥不得使用 NEXT_PUBLIC_ 前缀。
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# 至少 32 个随机字符，用于签发本机课程访问凭证。
COURSE_ACCESS_SECRET=replace_with_a_long_random_secret

# 只有明确设为 true 且密钥齐全时，网站才会创建真实支付订单。
PAYMENTS_ENABLED=false

# Auth.js 会话密钥。可使用 `npx auth secret` 生成。
AUTH_SECRET=replace_with_a_long_random_auth_secret

# 微信开放平台「网站应用」的 AppID 与 AppSecret。
# 回调地址：https://你的域名/api/auth/callback/wechat
AUTH_WECHAT_ID=replace_with_wechat_app_id
AUTH_WECHAT_SECRET=replace_with_wechat_app_secret

# 托管 PostgreSQL 连接。先执行 db/migrations/0001_accounts_and_entitlements.sql。
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
